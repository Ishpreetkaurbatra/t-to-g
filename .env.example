# ==============================================================================
# T→G (Trend to Growth) — Backend Environment Configuration
# ==============================================================================
# Note: Use placeholder values only. Never commit production secrets to Git.

# --- 1. Server Configuration ---
PORT=3000
NODE_ENV=development
# Allowed CORS origins (use '*' for public or comma-separated URLs like 'http://localhost:5173,http://localhost:3000')
CORS_ORIGIN="*"
# Request timeout in milliseconds (default: 15000 = 15s)
REQUEST_TIMEOUT_MS=15000

# --- 2. AI Engine Integration ---
# Provider selection: 'mock' | 'http' | 'gemini' (Default: 'mock')
# - 'mock': Zero-cost, resilient development mock adapter. No external API key needed.
# - 'http': Forward requests to external AI engine microservice (e.g., Python FastAPI/Flask).
# - 'gemini': Directly analyze with Google Gemini Generative AI (requires GEMINI_API_KEY).
AI_ENGINE_PROVIDER=mock

# Required ONLY if AI_ENGINE_PROVIDER is set to 'http':
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=your_ai_engine_api_key_here
AI_ENGINE_TIMEOUT_MS=10000

# Required ONLY if AI_ENGINE_PROVIDER is set to 'gemini':
GEMINI_API_KEY=your_gemini_api_key_here

# --- 3. Database (Supabase PostgreSQL) ---
# If omitted or offline, the backend automatically uses the built-in development fallback store.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- 4. Deployment / App Hosting ---
APP_URL=http://localhost:3000
